# Copy to `.env` for local development. Every VITE_* value is PUBLIC – it is
# embedded in the built JavaScript. Never put secrets here: the reCAPTCHA
# secret and the receiving email address live only in the Google Apps Script
# project's Script properties (see apps-script/README.md).
#
# In GitHub Actions the same names are read from repository *variables*
# (Settings → Secrets and variables → Actions → Variables).

# Public origin of the production site, no trailing slash. Used for canonical
# URLs, hreflang, Open Graph, structured data and sitemap.xml.
VITE_SITE_URL=https://hadesdesign.fi

# Google Apps Script web app URL of the contact form backend.
# Looks like https://script.google.com/macros/s/AKfycb.../exec
# PLACEHOLDER – fill in after deploying apps-script/ (see apps-script/README.md).
VITE_APPS_SCRIPT_URL=

# reCAPTCHA v3 SITE key (public). The SECRET key never goes here.
# PLACEHOLDER – created together with the Apps Script backend.
VITE_RECAPTCHA_SITE_KEY=

# Google Analytics 4 measurement ID. Analytics loads only after the visitor
# accepts cookies. Set to "off" to disable analytics and the cookie banner.
VITE_GA_MEASUREMENT_ID=G-62L4BW8BGX

# Set to "true" for preview/staging builds: adds noindex and a Disallow-all
# robots.txt so a preview copy is never indexed by search engines.
VITE_NOINDEX=

# Build-time only: public path when hosted under a sub-folder (GitHub project
# pages preview). Leave empty for the custom domain.
# Example: BASE_PATH=/hadesdesign/
BASE_PATH=
